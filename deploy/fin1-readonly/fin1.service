[Unit]
Description=Fin1 frozen read-only archive
After=network.target

[Service]
User=fin1
Group=fin1
WorkingDirectory=/opt/fin1
Environment=DJANGO_SETTINGS_MODULE=config.readonly
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/tmp
Environment=LANG=pt_BR.UTF-8
Environment=LC_ALL=pt_BR.UTF-8
ExecStart=/opt/fin1/.venv/bin/gunicorn --bind 127.0.0.1:8010 --workers 2 --timeout 120 --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
