{
  "name": "Fin2",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r requirements.txt",
  "forwardPorts": [8020],
  "portsAttributes": {
    "8020": {
      "label": "Fin2 Django",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "FIN2_DEBUG": "1",
    "FIN2_WRITE_ENABLED": "1",
    "FIN2_DATA_DIR": "/workspaces/Fin2/.codespaces-data"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
